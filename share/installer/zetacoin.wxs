<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Zetacoin Core"
           Manufacturer="Zetacoin Core developers"
           Version="$(var.ProductVersion)"
           UpgradeCode="7a1e3b4c-5d6f-4a8b-9c2d-1e3f5a7b9c0d"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Zetacoin Core is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="zetacoin.ico" SourceFile="$(var.SourceDir)\share\pixmaps\zetacoin.ico" />
    <Property Id="ARPPRODUCTICON" Value="zetacoin.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tuaris/zetacoin" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/tuaris/zetacoin" />

    <!-- Install directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Zetacoin" />
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ZetacoinStartMenu" Name="Zetacoin Core" />
    </StandardDirectory>

    <!-- Main feature -->
    <Feature Id="MainFeature" Title="Zetacoin Core" Level="1">
      <ComponentGroupRef Id="BinComponents" />
      <ComponentGroupRef Id="PlatformPlugins" />
      <ComponentGroupRef Id="StylePlugins" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="LicenseFile" />
    </Feature>

    <!-- GUI binaries -->
    <ComponentGroup Id="BinComponents" Directory="INSTALLFOLDER">
      <Component Id="ZetacoinQt" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567801">
        <File Id="zetacoin_qt.exe" Source="$(var.BinDir)\zetacoin-qt.exe" KeyPath="yes" />
      </Component>
      <Component Id="Zetacoind" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567802">
        <File Id="zetacoind.exe" Source="$(var.BinDir)\zetacoind.exe" KeyPath="yes" />
      </Component>
      <Component Id="ZetacoinCli" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567803">
        <File Id="zetacoin_cli.exe" Source="$(var.BinDir)\zetacoin-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="ZetacoinTx" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567804">
        <File Id="zetacoin_tx.exe" Source="$(var.BinDir)\zetacoin-tx.exe" KeyPath="yes" />
      </Component>
      <Component Id="ZetacoinWallet" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567805">
        <File Id="zetacoin_wallet.exe" Source="$(var.BinDir)\zetacoin-wallet.exe" KeyPath="yes" />
      </Component>
      <Component Id="ZetacoinUtil" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567806">
        <File Id="zetacoin_util.exe" Source="$(var.BinDir)\zetacoin-util.exe" KeyPath="yes" />
      </Component>
      <Component Id="Zetacoin" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567807">
        <File Id="zetacoin.exe" Source="$(var.BinDir)\zetacoin.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Qt platform plugins -->
    <Directory Id="PlatformsDir" Parent="INSTALLFOLDER" Name="platforms">
      <!-- defined inline -->
    </Directory>
    <ComponentGroup Id="PlatformPlugins" Directory="PlatformsDir">
      <Component Id="QWindowsDll" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567810">
        <File Id="qwindows.dll" Source="$(var.BinDir)\platforms\qwindows.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Qt styles plugins -->
    <Directory Id="StylesDir" Parent="INSTALLFOLDER" Name="styles">
      <!-- defined inline -->
    </Directory>
    <ComponentGroup Id="StylePlugins" Directory="StylesDir">
      <Component Id="QWindowsVistaStyle" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567811">
        <File Id="qwindowsvistastyle.dll" Source="$(var.BinDir)\styles\qwindowsvistastyle.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- License -->
    <Component Id="LicenseFile" Directory="INSTALLFOLDER" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567820">
      <File Id="COPYING" Source="$(var.SourceDir)\COPYING" KeyPath="yes" Name="COPYING.txt" />
    </Component>

    <!-- Start Menu shortcuts -->
    <Component Id="StartMenuShortcuts" Directory="ZetacoinStartMenu" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567830">
      <Shortcut Id="ZetacoinQtShortcut"
                Name="Zetacoin Core"
                Target="[INSTALLFOLDER]zetacoin-qt.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="zetacoin.ico" />
      <Shortcut Id="ZetacoinQtTestnet"
                Name="Zetacoin Core (testnet)"
                Target="[INSTALLFOLDER]zetacoin-qt.exe"
                Arguments="-testnet"
                WorkingDirectory="INSTALLFOLDER"
                Icon="zetacoin.ico" />
      <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Zetacoin Core" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- URL protocol handler -->
    <Component Id="UrlProtocol" Directory="INSTALLFOLDER" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567840">
      <RegistryKey Root="HKCR" Key="zetacoin">
        <RegistryValue Type="string" Value="URL:Zetacoin" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zetacoin\DefaultIcon">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]zetacoin-qt.exe" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zetacoin\shell\open\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]zetacoin-qt.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <!-- WiX UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\share\installer\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\share\installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\share\installer\dialog.bmp" />

  </Package>
</Wix>
